# Linux-native Gateway and API client share the same host.
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=901
IBKR_TIMEOUT_SECONDS=15
IBKR_REALTIME_SECONDS=10
ES_SYMBOL=ES
ES_EXCHANGE=CME
ES_CURRENCY=USD
# Automatic live-contract selection. Do not maintain a contract month manually.
ES_ROLL_MODE=cme_equity_lead_month
